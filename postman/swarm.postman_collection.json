            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantProfile\": \"hardened\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Live event stream (SSE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/runs/{{id}}/events?since=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "runs",
                "{{id}}",
                "events"
              ],
              "query": [
                {
                  "key": "since",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Server-sent events. `?since=<eventId>` replays from the log first (also honours Last-Event-ID). Heartbeat comment every 15 s. Sends `event: done` when the run has finished."
          }
        }
      ]
    },
