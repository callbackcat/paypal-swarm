# Copy to .env. Everything is optional: with no values at all Swarm runs with an in-process PayPal mock
# and scripted zero-token agents. Add credentials to flip to sandbox + live Claude shoppers, no code change.

# --- PayPal sandbox (Business account REST app, Merchant type, Advanced Card Payments enabled) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=          # optional; learned from the first order's payee if empty (needed for chargebacks)
PAYPAL_WEBHOOK_ID=           # after registering https://<api host>/webhooks/paypal in the dashboard
SWARM_ORDER_CREATE=auto      # auto | toolkit | sdk  (how shoppers create orders; auto = Server SDK without payment_source)

# --- LLM via OpenRouter (API key only; set a per-key spend limit on openrouter.ai) ---
OPENROUTER_API_KEY=
SWARM_MODEL_SHOPPER=anthropic/claude-haiku-5.5
SWARM_MODEL_MERCHANT=anthropic/claude-sonnet-5.5
SWARM_MODEL_ANALYST=anthropic/claude-sonnet-5.5
SWARM_RUN_TOKEN_CAP=400000   # default per-run cap; Black Friday ships with its own 600k cap, Setup lets you edit it
DEMO_DAILY_TOKEN_CAP=1500000 # per-IP daily allowance when the server's own key is used (bring-your-own keys are not fenced)
LLM_CACHE=0                  # 1 = content-addressed dev cache in Postgres (identical prompts cost zero; hit counts shown in the report)

# --- Storage / platform ---
DATABASE_URL=postgres://postgres@localhost:5433/swarm   # omit to keep runs in memory (lost on restart)
SWARM_KMS_KEY=               # 32-byte base64 key for encrypting bring-your-own credentials at rest (any secret is stretched with SHA-256)
API_PORT=8787
CORS_ORIGIN=*                # or https://your-web-host
PUBLIC_API_URL=              # used in /openapi.json servers[]; Render sets RENDER_EXTERNAL_URL automatically
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=   # AG Studio trial key (production builds watermark without it)
